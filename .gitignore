*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual env
venv/
.venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE
.vscode/
.idea/

# Env / secrets
.env
.env.local

# Logs and outputs
logs/
*.log

# The bot persists its audit trail back to the repo. Everything else in
# output/ (caches, test sidecars, contaminated archives) stays ignored.
# NOTE: trade_log.jsonl/csv + dashboard_state.json are tracked ONLY because
# the bot commits its own state (Dec 2026 fix pending to move state off the
# repo entirely). Local dev sessions must never grow them — run pytest with
# --basetemp outside the repo (done in CI) and never main.py loops locally
# without TRIO_TEST_MODE=1.
output/*
!output/plans/
!output/dashboard_state.json
!output/subscribers.json
output/plans/*
!output/plans/*.json

# OS
.DS_Store
Thumbs.db

# Historical yfinance caches (large)
scripts/_data_cache*/

